<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.GuruTube" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">#0F0F0F</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Modern SplashScreen theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Background color of the splash screen -->
        <item name="windowSplashScreenBackground">#010101</item>
        <!-- Icon to be displayed -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/logo</item>
        <!-- Icon background color (Required for some Android 12 implementations and good for consistency) -->
        <item name="windowSplashScreenIconBackgroundColor">#010101</item>
        <!-- Duration the splash screen will be displayed -->
        <item name="windowSplashScreenAnimationDuration">800</item>
        <!-- The theme to use after the splash screen is finished -->
        <item name="postSplashScreenTheme">@style/Theme.GuruTube</item>
    </style>
</resources>
